<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.crecrm.listingspaces</string>
  <!-- zsh -lc so the login PATH (homebrew/nvm node) is available; launchd's own env is bare -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd '/Users/apop/CRE CRM/scripts/listing-spaces' &amp;&amp; npm start</string>
  </array>
  <!-- FOUR times a day, 6h apart (00:40, 06:40, 12:40, 18:40 local). The gentle
       profile (worker.mjs env): ~15 listings per run at a 2-4 min variable gap, so a
       session trickles over ~45 min instead of a burst — we walled inside one 13-min
       burst on 08-31, and the low instantaneous rate is the lever the short-window wall
       most likely keys on. Each run STOPS on two consecutive walls and self-throttles
       (a run begun while the wall is up costs a page or two). ~908 target listings; at
       a wall-free ~60/day, first full pass in ~15 days, then maintenance. Dial the pace
       via LS_LIMIT / LS_GAP_MIN_SEC / LS_GAP_MAX_SEC in .env if the wall proves lenient. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>0</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/apop/Library/Logs/listing-spaces.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apop/Library/Logs/listing-spaces.log</string>
</dict>
</plist>
