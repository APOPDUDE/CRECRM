<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.crecrm.listingspaces</string>
  <!-- zsh -lc so the login PATH (homebrew/nvm node) is available; launchd's own env is bare -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd '/Users/apop/CRE CRM/scripts/listing-spaces' &amp;&amp; npm start</string>
  </array>
  <!-- FOUR times a day, 6h apart (00:40, 06:40, 12:40, 18:40 local). Slow gap
       (2-4 min variable, worker.mjs env) is the wall-avoidance lever; the per-run cap
       is 40 only as a CEILING — stop-on-2-walls means the site, not the cap, ends a run,
       so a lenient-wall run can harvest fully (~160/day across the 4 runs) while a wall-y
       one just stops early and costs nothing. ~908 target listings → first full pass in
       roughly a week if the wall tolerates the slower rate, longer if it keeps trimming.
       Tune via LS_LIMIT / LS_GAP_MIN_SEC / LS_GAP_MAX_SEC in .env from the run log. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>0</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/apop/Library/Logs/listing-spaces.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apop/Library/Logs/listing-spaces.log</string>
</dict>
</plist>
