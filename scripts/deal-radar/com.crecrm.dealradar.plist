<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.crecrm.dealradar</string>
  <!-- zsh -lc so the login PATH (homebrew/nvm node) is available; launchd's own env is bare -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd '/Users/alexanderpoplawski/CRECRM/scripts/deal-radar' &amp;&amp; npm start</string>
  </array>
  <!-- every 3h; a cycle is now 1 wide search center x 9 keywords = 9 searches at
       5-10 min spacing (~45-90 min) plus the group pass, so 3h leaves headroom -->
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/alexanderpoplawski/Library/Logs/deal-radar.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alexanderpoplawski/Library/Logs/deal-radar.log</string>
</dict>
</plist>
