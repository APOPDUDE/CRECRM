# Copy to .env (gitignored — this repo is PUBLIC, never commit the real one).
SUPABASE_URL=https://sxlttnxcutnrdzcldafh.supabase.co
# Dashboard -> Project Settings -> API -> service_role (worker runs server-side on the Mac)
SUPABASE_SERVICE_ROLE_KEY=
# Absolute path to the built MCP entrypoint (see README: clone + npm install + npm run build)
FB_MCP_PATH=/Users/apop/facebook-marketplace-mcp/dist/index.js
# Chrome profile whose Facebook session the MCP replays
CHROME_PROFILE=Default
# Optional: n8n webhook that forwards {source,message} to Slack; blank = log-only alerts
ALERT_WEBHOOK_URL=
# Optional: Slack INCOMING webhook (https://hooks.slack.com/services/...). New listings
# in the target metros (Tampa/Pinellas/Pasco/Sarasota/Manatee) get pinged here; blank = off
SLACK_WEBHOOK_URL=
