# Where the PostGIS cache lives. Default deployment: the hosted Supabase
# Postgres itself (gis schema) — use the SESSION POOLER connection string
# (Dashboard -> Connect -> Session pooler; IPv4-safe), e.g.
#   postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# For local development, docker compose up and use the default below.
GIS_PG_DSN=postgresql://gis:gis@localhost:5433/gis

# Supabase REST — used by `enrichment parcels` (pull the tracked book) and by
# the phase-2 push. Service-role key: same key n8n holds, NEVER committed,
# never shipped to a browser.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
