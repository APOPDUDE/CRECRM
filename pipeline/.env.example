# Local PostGIS cache (docker-compose.yml default)
GIS_PG_DSN=postgresql://gis:gis@localhost:5433/gis

# Supabase — used by `enrichment parcels` (pull the tracked book) and later by
# the push step. Service-role key: same key n8n holds, NEVER committed, never
# shipped to a browser.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
